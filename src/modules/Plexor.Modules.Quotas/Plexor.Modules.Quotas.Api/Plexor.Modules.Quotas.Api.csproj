<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4.5.g.3: UpsertQuotaAssignmentRequestValidator (FluentValidation)
         shares the same NuGet version as Application/Infrastructure/Shared
         (Directory.Packages.props is off — explicit versions here). -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plexor.Modules.Quotas.Application\Plexor.Modules.Quotas.Application.csproj" />
    <ProjectReference Include="..\Plexor.Modules.Quotas.Domain\Plexor.Modules.Quotas.Domain.csproj" />
    <ProjectReference Include="..\..\..\shared\security\Plexor.Shared.Authorization\Plexor.Shared.Authorization.csproj" />
    <ProjectReference Include="..\..\..\shared\kernel\Plexor.Shared.Contracts\Plexor.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\kernel\Plexor.Shared.Kernel\Plexor.Shared.Kernel.csproj" />
    <ProjectReference Include="..\Plexor.Modules.Quotas.Infrastructure\Plexor.Modules.Quotas.Infrastructure.csproj" />
    <!-- 4.5.g.2: QuotasController needs ICurrentUser to read the
         caller's TenantId for tenant-scoped assignment / usage /
         effective queries. The interface lives in
         Plexor.Modules.Sigil.Application.Abstractions — Quotas does
         not depend on the Sigil Infrastructure layer (the
         HttpContextCurrentUser implementation), only on the
         Application-layer abstraction. -->
    <ProjectReference Include="..\..\Plexor.Modules.Sigil\Plexor.Modules.Sigil.Application\Plexor.Modules.Sigil.Application.csproj" />
    <PackageReference Remove="Meziantou.Analyzer" />
  </ItemGroup>

</Project>
