<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      OpenAPI document generation runs on every `dotnet build`. Emits
      artifacts/openapi.json at repo root, consumed by frontend `pnpm codegen`
      (openapi-typescript + kubb). Resolved relative to the csproj:
      src/host/Plexor.Host -> ../../../artifacts.
    -->
    <OpenApiDocumentsDirectory>../../../artifacts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plexor.Host.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ============ Composition + shared ============ -->
    <ProjectReference Include="..\..\shared\kernel\Plexor.Shared.Kernel\Plexor.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\shared\kernel\Plexor.Shared.Contracts\Plexor.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\infra\Plexor.Shared.Composition\Plexor.Shared.Composition.csproj" />
    <ProjectReference Include="..\..\shared\infra\Plexor.Shared.Telemetry\Plexor.Shared.Telemetry.csproj" />
    <ProjectReference Include="..\..\shared\infra\Plexor.Shared.Configuration\Plexor.Shared.Configuration.csproj" />
    <ProjectReference Include="..\..\shared\infra\Plexor.Shared.Http\Plexor.Shared.Http.csproj" />
    <ProjectReference Include="..\..\shared\persistence\Plexor.Shared.Persistence\Plexor.Shared.Persistence.csproj" />
    <ProjectReference Include="..\..\shared\kernel\Plexor.Shared.NodeApi\Plexor.Shared.NodeApi.csproj" />
    <ProjectReference Include="..\..\shared\security\Plexor.Shared.Mtls\Plexor.Shared.Mtls.csproj" />

    <!-- ============ Modules (all wired) ============ -->
    <ProjectReference Include="..\..\modules\Plexor.Modules.Sigil\Plexor.Modules.Sigil.Application\Plexor.Modules.Sigil.Application.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Sigil\Plexor.Modules.Sigil.Infrastructure\Plexor.Modules.Sigil.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Sigil\Plexor.Modules.Sigil.Api\Plexor.Modules.Sigil.Api.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Clusters\Plexor.Modules.Clusters.Api\Plexor.Modules.Clusters.Api.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Realm\Plexor.Modules.Realm.Application\Plexor.Modules.Realm.Application.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Realm\Plexor.Modules.Realm.Infrastructure\Plexor.Modules.Realm.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Sigil\Plexor.Modules.Sigil.Domain\Plexor.Modules.Sigil.Domain.csproj" />
    <!-- Phase 4.5 — quotas enforcer + scope resolver (4.5.b). The
         Application layer holds IQuotaCatalog; Infrastructure holds
         IQuotaScopeResolver + IQuotaEnforcer + the DbContext; Api
         holds the exception handler (4.5.g.1) and will hold the
         controllers (4.5.g.2). -->
    <ProjectReference Include="..\..\modules\Plexor.Modules.Quotas\Plexor.Modules.Quotas.Application\Plexor.Modules.Quotas.Application.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Quotas\Plexor.Modules.Quotas.Infrastructure\Plexor.Modules.Quotas.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Quotas\Plexor.Modules.Quotas.Api\Plexor.Modules.Quotas.Api.csproj" />
    <!-- Branding module — operator-global + per-org branding.
         Application hosts the BrandingGlobalSeeder; Infrastructure
         wires the EF IBrandingService; Api hosts the controllers
         + FluentValidation validators. -->
    <ProjectReference Include="..\..\modules\Plexor.Modules.Branding\Plexor.Modules.Branding.Application\Plexor.Modules.Branding.Application.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Branding\Plexor.Modules.Branding.Infrastructure\Plexor.Modules.Branding.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Branding\Plexor.Modules.Branding.Api\Plexor.Modules.Branding.Api.csproj" />
    <!-- Phase 5.1 — audit module. Application hosts the read endpoint
         (5.2); Infrastructure hosts the IAuditEmitter (DbAuditEmitter)
         + AuditDbContext. Api hosts the GET /api/v1/audit endpoint
         (5.2) and the future admin UI surface (5.3). -->
    <ProjectReference Include="..\..\modules\Plexor.Modules.Audit\Plexor.Modules.Audit.Application\Plexor.Modules.Audit.Application.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Audit\Plexor.Modules.Audit.Infrastructure\Plexor.Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Audit\Plexor.Modules.Audit.Api\Plexor.Modules.Audit.Api.csproj" />
    <!-- Phase 4.5.d — Storage module. Application layer holds the
         IVolumeService / IBucketService contracts (commit 2);
         Infrastructure wires StorageDbContext + EfStorageQuotaReader
         (the seam the Quotas enforcer depends on). The Api layer
         + the REST endpoints land in commit 2. -->
    <ProjectReference Include="..\..\modules\Plexor.Modules.Storage\Plexor.Modules.Storage.Application\Plexor.Modules.Storage.Application.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Storage\Plexor.Modules.Storage.Infrastructure\Plexor.Modules.Storage.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Plexor.Modules.Storage\Plexor.Modules.Storage.Api\Plexor.Modules.Storage.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.4.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.0" />
    <PackageReference Remove="Meziantou.Analyzer" />
  </ItemGroup>

</Project>
