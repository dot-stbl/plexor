<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Plexor.Shared.Filtering</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    Plexor.Shared.Filtering.Core — pure BCL filtering DSL.

    Contains the parser, lexer, AST, operator registry, field set registry, and
    IQueryable extension. Zero ASP.NET Core, zero EF Core, zero OpenAPI — only
    System.Linq.Expressions + System.Collections.Concurrent + the standard
    Microsoft.Extensions.* abstractions for the DI extension below.

    The MVC binding metadata ([FromQuery(Name=...)] on FilterQuery) was
    dropped when this split happened: property names already match the wire
    names (filter, sort, page, pageSize), so the default ASP.NET Core model
    binder + OpenAPI source generator pick them up without the attributes.
    See Plexor.Shared.Filtering.Web for the ASP.NET-specific wiring.

    Web concerns (OpenAPI schema transformers, IOpenApiSchemaTransformer) live
    in Plexor.Shared.Filtering.Web. Domain modules reference ONLY this Core
    project — that's the architecture rule enforced by
    Plexor.ArchitectureTests.DomainIsolationShould.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Remove="Meziantou.Analyzer" />
  </ItemGroup>

</Project>
