# Dev environment — no implicit mock activation.
#
#   bun run dev        → real API; requires VITE_API_URL (fails fast at
#                        startup when unset — see assertApiConfigured in
#                        main.tsx)
#   bun run dev:mock   → kubb + MSW faker mocks (the script sets
#                        VITE_USE_MOCKS=true itself)
#
# Mocks activate ONLY via the explicit VITE_USE_MOCKS=true flag; there is no
# env-absence fallback anywhere. Uncomment and point at your Plexor.Host to
# run against a real backend:
#
# VITE_API_URL=https://localhost:7443
