{
  "name": "@plexor/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCKS=true vite",
    "build": "vite build",
    "build:mock": "VITE_USE_MOCKS=true vite build",
    "preview": "vite preview",
    "gate": "bun run typecheck && bun run lint && bun run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mocks": "VITE_USE_MOCKS=true vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build --output-dir dist-storybook",
    "test:visual": "bun run scripts/visual-test-runner.ts",
    "test:visual:update": "bun run scripts/visual-test-runner.ts --update",
    "test:visual:cleanup": "bun run scripts/visual-test-runner.ts --cleanup-only",
    "gen:tech-icons": "node scripts/gen-tech-icons.cjs",
    "shot": "bun run scripts/agent/shot.ts",
    "agent:rules": "bun run scripts/agent/lint-rules.ts",
    "check:domains": "bun run scripts/agent/check-domain-boundaries.ts",
    "agent:check": "bun run scripts/agent/check.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.2.11",
    "@hookform/resolvers": "3.10.0",
    "@iconify/react": "^6.0.2",
    "@kubb/plugin-client": "4.39.2",
    "@nine-thirty-five/material-symbols-react": "^2.1.4",
    "@plexor/ui": "workspace:*",
    "@tanstack/react-query": "5.95.0",
    "@tanstack/react-router": "1.91.0",
    "@tanstack/react-table": "^8.21.3",
    "@uidotdev/usehooks": "^2.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-aria-components": "^1.21.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.0",
    "react-i18next": "^17.0.9",
    "react-resizable-panels": "^4.12.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "2.5.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
