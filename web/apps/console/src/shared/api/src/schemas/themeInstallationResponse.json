{"type":"object","description":"Active marketplace theme + the signature the FE boot script re-verifies.","required":["orgId","themeId","name","version","author","manifestSignature","activatedAt","activatedBy"],"properties":{"orgId":{"type":"string","format":"uuid"},"themeId":{"type":"string","maxLength":64,"example":"synthwave-night-dark"},"name":{"type":"string","maxLength":128,"example":"Synthwave Night — Dark"},"version":{"type":"string","maxLength":64,"example":"0.1.0"},"author":{"type":"string","maxLength":128,"example":"plexor-themes"},"manifestSignature":{"type":"string","minLength":64,"maxLength":64,"pattern":"^[0-9a-fA-F]{64}$","description":"Hex-encoded HMAC-SHA256 persisted on the row."},"activatedAt":{"type":"string","format":"date-time"},"activatedBy":{"type":"string","format":"uuid"}},"x-readme-ref-name":"ThemeInstallationResponse"}