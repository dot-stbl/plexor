{"type":"object","description":"Top-level response for GET /api/v1/vsphere/inventory. Bundles the snapshot header + the per-resource row lists so the caller can render the inventory in a single round trip.","required":["snapshot","clusters","hosts","virtualMachines"],"properties":{"snapshot":{"type":"object","description":"Snapshot header for GET /api/v1/vsphere/inventory. Carries the snapshot id + per-resource row counts + the refresh timestamp.","required":["id","vcenterMoref","datacenterCount","clusterCount","hostCount","virtualMachineCount","refreshedAt"],"properties":{"id":{"type":"string","format":"uuid","description":"Snapshot id (UUID v7)."},"vcenterMoref":{"type":"string","description":"vCenter identifier the snapshot was pulled from.","example":"primary"},"datacenterCount":{"type":"integer","minimum":0,"example":1},"clusterCount":{"type":"integer","minimum":0,"example":2},"hostCount":{"type":"integer","minimum":0,"example":6},"virtualMachineCount":{"type":"integer","minimum":0,"example":42},"refreshedAt":{"type":"string","format":"date-time","description":"UTC timestamp the snapshot was written."}},"x-readme-ref-name":"VSphereInventorySnapshotHeader"},"clusters":{"type":"array","items":{"type":"object","description":"Cluster row in the vSphere inventory snapshot.","required":["moref","name","datacenterMoref","drsEnabled"],"properties":{"moref":{"type":"string","example":"domain-c7","description":"Cluster mo-ref."},"name":{"type":"string","example":"cluster-prod-01"},"datacenterMoref":{"type":"string","example":"datacenter-2","description":"Parent datacenter mo-ref."},"drsEnabled":{"type":"boolean","description":"When true, vSphere DRS handles initial placement + load balancing.","example":true}},"x-readme-ref-name":"VSphereInventoryClusterRow"}},"hosts":{"type":"array","items":{"type":"object","description":"ESXi host row in the vSphere inventory snapshot.","required":["moref","name","clusterMoref","connectionState","cpuCores","memoryMib"],"properties":{"m