{"type":"object","description":"The org's identity-provider configuration. Sensitive fields (client secrets, bind passwords) are write-only; the GET response carries a sentinel (`***`) instead of the real value.","required":["orgId","provider","updatedAt"],"properties":{"orgId":{"type":"string","format":"uuid"},"provider":{"type":"string","enum":["local","oidc","ldap"],"description":"Active provider for this org.","example":"oidc"},"updatedAt":{"type":"string","format":"date-time"},"oidc":{"type":"object","nullable":true,"description":"OIDC-specific config (only set when provider = oidc).","required":["issuer","clientId"],"properties":{"issuer":{"type":"string","format":"uri","example":"https://kc.example.com/realms/tessera"},"clientId":{"type":"string","example":"tessera-console"},"clientSecretSentinel":{"type":"string","nullable":true,"description":"`***` when a secret is stored; null when none configured.","example":"***"},"scopes":{"type":"array","items":{"type":"string"},"example":["openid","profile","email"]},"redirectUri":{"type":"string","format":"uri","example":"https://console.example.com/auth/oidc/callback"},"claimMappings":{"type":"object","description":"Maps OIDC claims onto Plexor user fields.","additionalProperties":{"type":"string"},"example":{"org":"https://plexor.example.com/claims/org","team":"https://plexor.example.com/claims/team"}}}},"ldap":{"type":"object","nullable":true,"description":"LDAP-specific config (only set when provider = ldap).","required":["server","baseDn","bindDn","userFilter"],"properties":{"server":{"type":"string","example":"ldap://ldap.example.com"},"baseDn":{"type":"string","example":"dc=example,dc=com"},"bindDn":{"type":"string","example":"cn=plexor,ou=services,dc=example,dc=com"},"bindPasswordSentinel":{"type":"string","nullable":true,"description":"`***` when a password is stored; null when none configured.","example":"***"},"userFilter":{"type":"string","example":"(uid={0})"},"roleAttribute":{"type":"string","nullable":true,"example":"memberOf"}}}},"x-readme-ref-name":"OrgAuthProviderConfigResponse"}