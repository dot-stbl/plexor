{
  "name": "plexor-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "tooling/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '@plexor/console' dev",
    "build": "bun --filter '@plexor/console' build",
    "test": "bun --filter '@plexor/console' test",
    "lint": "bun --filter '@plexor/console' lint",
    "typecheck": "bun --filter '@plexor/console' typecheck",
    "dev:www": "bun --filter '@plexor/www' dev",
    "build:www": "bun --filter '@plexor/www' build",
    "test:www": "bun --filter '@plexor/www' test",
    "lint:www": "bun --filter '@plexor/www' lint",
    "typecheck:www": "bun --filter '@plexor/www' typecheck"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "playwright": "^1.63.0"
  }
}
